# Required
GOOGLE_API_KEY=
CONTACT_EMAIL=
VERSION=autodrome/dev
LIBRARY_PATH=./library

# Backend
API_HOST=127.0.0.1
API_PORT=5000
API_TOKEN=
CORS_ORIGINS=
LOG_LEVEL=INFO
REDIS_ENABLED=false

# Frontend development server
VITE_HOST=127.0.0.1
VITE_PORT=5173

# Album processing
MIN_STAGING_FREE_BYTES=1073741824
PRESERVE_FAILED_STAGING=true
MAX_EMBEDDED_COVER_BYTES=1048576
OPTIMIZE_OVERSIZED_COVERS=true
MAX_EMBEDDED_COVER_WIDTH=1600
MAX_EMBEDDED_COVER_HEIGHT=1600
MAX_COVER_SOURCE_PIXELS=40000000
DOWNLOAD_CONCURRENCY=1

# MusicBrainz (each request attempt; starts are always at least one second apart)
MUSICBRAINZ_TIMEOUT_SECONDS=20
MUSICBRAINZ_MAX_ATTEMPTS=3
MUSICBRAINZ_RETRY_BASE_SECONDS=1
